import tkinter as tk
from tkinter import messagebox
from datetime import datetime

PASSWORD = "qwer"
LOG_FILE = "history.txt"


def write_log(text):
    with open(LOG_FILE, "a", encoding="utf-8") as file:
        file.write(text + "\n")


def check_password():
    user_pass = entry_password.get()
    time_now = datetime.now().strftime("%d.%m.%Y %H:%M")

    if user_pass == PASSWORD:
        write_log(f"{time_now} - Успешный вход с паролем '{user_pass}'")
        login_window.destroy()
        open_calculator()
    else:
        write_log(f"{time_now} - Попытка входа с паролем '{user_pass}' - НЕУСПЕШНО")
        messagebox.showerror("Ошибка", "Неверный пароль")


def open_calculator():
    calc = tk.Tk()
    calc.title("Калькулятор")
    calc.configure(bg="#2C2F33")

    entry = tk.Entry(calc, width=20, font=("Arial", 24), bd=5,
                     relief=tk.RIDGE, justify="right")
    entry.grid(row=0, column=0, columnspan=4, pady=10)

    def add(symbol):
        entry.insert(tk.END, symbol)

    def clear():
        entry.delete(0, tk.END)

    def calculate():
        expression = entry.get()
        time_now = datetime.now().strftime("%d.%m.%Y %H:%M")

        try:
            result = eval(expression)
            entry.delete(0, tk.END)
            entry.insert(0, str(result))
            write_log(f"{time_now} - Вычисление: {expression} = {result}")
        except:
            messagebox.showerror("Ошибка", "Неверное выражение")

    # Создание кнопки с стилем
    def create_button(text, row, col, bg, command, colspan=1):
        tk.Button(calc,
                  text=text,
                  width=5,
                  height=2,
                  font=("Arial", 16, "bold"),
                  bg=bg,
                  fg="white",
                  bd=0,
                  command=command
                  ).grid(row=row, column=col, columnspan=colspan, padx=5, pady=5)

    # Цвета
    num_color = "#4F545C"
    op_color = "#F39C12"
    eq_color = "#2ECC71"
    clear_color = "#E74C3C"

    # Кнопки
    buttons = [
        ('7', 1, 0, num_color), ('8', 1, 1, num_color), ('9', 1, 2, num_color), ('/', 1, 3, op_color),
        ('4', 2, 0, num_color), ('5', 2, 1, num_color), ('6', 2, 2, num_color), ('*', 2, 3, op_color),
        ('1', 3, 0, num_color), ('2', 3, 1, num_color), ('3', 3, 2, num_color), ('-', 3, 3, op_color),
        ('0', 4, 0, num_color), ('C', 4, 1, clear_color), ('=', 4, 2, eq_color), ('+', 4, 3, op_color),
    ]

    for (text, row, col, color) in buttons:
        if text == "=":
            create_button(text, row, col, color, calculate)
        elif text == "C":
            create_button(text, row, col, color, clear)
        else:
            create_button(text, row, col, color, lambda t=text: add(t))

    calc.mainloop()


# Окно входа
login_window = tk.Tk()
login_window.title("Вход")
login_window.geometry("250x120")

tk.Label(login_window, text="Введите пароль:", font=("Arial", 12)).pack(pady=5)

entry_password = tk.Entry(login_window, show="*", font=("Arial", 12))
entry_password.pack(pady=5)

tk.Button(login_window, text="Войти", font=("Arial", 12),
          command=check_password).pack(pady=5)

login_window.mainloop()
